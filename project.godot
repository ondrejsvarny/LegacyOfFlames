"Wizard": "res://Scenes/dialogues/Wizard.dch",
"dialogues/witch": "res://Scenes/dialogues/witch.dch",
"unit_test_character": "res://Tests/Resources/unit_test_character.dch",
"witch": "res://Assets/NPC/witch.dch"
}
directories/dtl_directory={
"coins": "res://Scenes/dialogues/coins.dtl",
"intro_level1": "res://Scenes/dialogues/intro_level1.dtl",
"not_enough_money": "res://Scenes/dialogues/not_enough_money.dtl",
